{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeStableNonMajor"
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/-values\\.ya?ml$/"
    ]
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub releases from all YAML files",
      "managerFilePatterns": [
        "/.*\\.yaml$/"
      ],
      "matchStrings": [
        "https://github.com/(?<depName>[^ /]+/[^ /]+)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update versions from renovate comments in YAML",
      "managerFilePatterns": [
        "/.*\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s*\\n\\s*-?\\s*\\w+:\\s*[\"']?(?:[^\\s\"'@]+:)?(?<currentValue>[^\\s\"'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "{{{versioning}}}"
    }
  ]
}